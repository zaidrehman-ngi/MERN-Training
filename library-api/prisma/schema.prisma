generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model books {
  book_id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  author           String?
  isbn             String?           @unique(map: "books_active_isbn_unique", where: raw("(is_active = true)"))
  publication_year Int?
  cover_url        String?
  available_copies Int               @default(0)
  total_copies     Int               @default(0)
  fine_per_day     Int?
  status           String            @default("available")
  is_active        Boolean           @default(true)
  borrow_requests  borrow_requests[]
}

model branches {
  branch_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  address   String?
  phone     String?
  members   members[]
}

model members {
  member_id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  email           String?           @unique(map: "members_active_email_unique", where: raw("(is_active = true)"))
  password_hash   String?           @db.Char(60)
  role            String            @default("user")
  phone           String?
  joined_on       DateTime?         @db.Date
  branch_id       String            @db.Uuid
  is_active       Boolean           @default(true)
  borrow_requests borrow_requests[]
  refresh_tokens  refresh_tokens[]
  notifications   notifications[]
  branches        branches          @relation(fields: [branch_id], references: [branch_id], onDelete: NoAction, onUpdate: NoAction)
}

// A member asking to borrow a book (the API's /borrow-requests).
model borrow_requests {
  request_id    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id     String          @db.Uuid
  book_id       String          @db.Uuid
  status        String          @default("pending")
  requested_on  DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_on        DateTime?       @db.Date
  queued_at     DateTime?       @db.Timestamptz(6)
  hold_until    DateTime?       @db.Date
  fine_per_day  Int             @default(20)
  returned_at   DateTime?       @db.Timestamptz(6)
  fine          Int?
  notifications notifications[]
  members       members         @relation(fields: [member_id], references: [member_id], onDelete: NoAction, onUpdate: NoAction)
  books         books           @relation(fields: [book_id], references: [book_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id])
  @@index([book_id])
  @@index([book_id, queued_at], map: "borrow_requests_queue_idx", where: raw("(status = 'queued'::text)"))
}

// Refresh tokens (Exercise 8 Task 4). Only a SHA-256 hash of the token is
// stored, so a copy of this table can't be used to log in.
model refresh_tokens {
  token_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id  String    @db.Uuid
  token_hash String    @unique @db.Char(64)
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  members    members   @relation(fields: [member_id], references: [member_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id])
}

// Access tokens that were logged out before they expired (Exercise 8 Task 5).
// A row only needs to stay until expires_at; after that the token is dead anyway.
model revoked_tokens {
  jti        String   @id @db.Uuid
  expires_at DateTime @db.Timestamptz(6)

  @@index([expires_at])
}

model notifications {
  notification_id String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id       String           @db.Uuid
  request_id      String?          @db.Uuid
  kind            String
  message         String
  for_date        DateTime         @db.Date
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  members         members          @relation(fields: [member_id], references: [member_id], onDelete: NoAction, onUpdate: NoAction)
  borrow_requests borrow_requests? @relation(fields: [request_id], references: [request_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([request_id, kind, for_date])
  @@index([member_id])
}
