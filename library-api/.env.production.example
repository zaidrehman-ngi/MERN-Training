# Production values. Set every one of these in the hosting dashboard.
# The host does not read this file or .env.example.
NODE_ENV=production

# Most hosts set PORT themselves.
PORT=3000

# Connection string of the hosted PostgreSQL database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/karachi_library

# A new random secret, not the one used locally.
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Address of the deployed frontend, https and no trailing slash.
CORS_ORIGIN=https://your-frontend-host

ACCESS_LOG_PATH=logs/access.log

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX=60

LOG_LEVEL=info

# Printing every query fills the logs on a server.
DB_QUERY_LOG=false

BCRYPT_COST=12

LOAN_PERIOD_DAYS=14
FINE_PER_DAY=20
FINE_MAX_DAYS=30
HOLD_DAYS=3
HOLD_EXPIRY_SCHEDULE=5 0 * * *
LIBRARY_TIME_ZONE=Asia/Karachi
DUE_REMINDER_SCHEDULE=0 8 * * *

# Never reset data on the server.
ALLOW_SEED=false
