# Copy this file to .env and set values for your machine.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by the SQL query benchmark and later ORM work.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/karachi_library

# Generate a private secret, for example with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-strong-secret
# Access token: short, because it is sent with every request.
JWT_EXPIRES_IN=15m
# Refresh token: longer, only ever sent to POST /api/v1/auth/refresh.
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# Relative to the library-api directory, or provide an absolute path.
UPLOADS_PATH=uploads
ACCESS_LOG_PATH=logs/access.log

# Maximum API requests per client IP in each window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX=60

# One of: debug, info, warn, error, silent.
LOG_LEVEL=info

# Print every SQL query Prisma sends (with its parameters and time). true or false.
DB_QUERY_LOG=true

# bcrypt cost factor for password hashes (10 to 15). Each +1 doubles the time.
BCRYPT_COST=12
