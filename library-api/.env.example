# Copy this file to .env and set values for your machine.
NODE_ENV=development
PORT=3000

# Generate a private secret, for example with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=1h

# Frontend origin allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# Relative to the library-api directory, or provide an absolute path.
UPLOADS_PATH=uploads

# Maximum API requests per client IP in each window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX=60

# One of: debug, info, warn, error, silent.
LOG_LEVEL=info
