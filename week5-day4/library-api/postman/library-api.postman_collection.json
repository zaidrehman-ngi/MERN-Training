        {
          "name": "Login - Rate Limited",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loginUrl = `${pm.environment.get(\"baseUrl\")}/api/v1/auth/login`;\r\nconst payload = JSON.stringify({ email: \"postman-rate-limit@lib.pk\", password: \"WrongPassword123!\" });\r\nfor (let attempt = 0; attempt < 5; attempt += 1) {\r\n    await new Promise((resolve, reject) => {\r\n        pm.sendRequest({\r\n            url: loginUrl,\r\n            method: \"POST\",\r\n            header: { \"Content-Type\": \"application/json\" },\r\n            body: { mode: \"raw\", raw: payload }\r\n        }, (error) => error ? reject(error) : resolve());\r\n    });\r\n}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 429\", function () {\r\n    pm.response.to.have.status(429);\r\n});\r\n\r\npm.test(\"Rate-limit error uses the standard error shape\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body).to.have.all.keys(\"error\", \"message\", \"details\");\r\n    pm.expect(body.error).to.eql(\"RATE_LIMIT_EXCEEDED\");\r\n    pm.expect(body.message).to.be.a(\"string\").and.not.empty;\r\n    pm.expect(body.details).to.be.an(\"array\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
