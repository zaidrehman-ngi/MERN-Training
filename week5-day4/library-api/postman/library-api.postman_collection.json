                "exec": [
                  "pm.test(\"Status code is 403\", function () {\r\n    pm.response.to.have.status(403);\r\n});\r\n\r\npm.test(\"Forbidden error uses the standard error shape\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body).to.have.all.keys(\"error\", \"message\", \"details\");\r\n    pm.expect(body.error).to.eql(\"FORBIDDEN\");\r\n    pm.expect(body.message).to.be.a(\"string\").and.not.empty;\r\n    pm.expect(body.details).to.be.an(\"array\");\r\n});"
