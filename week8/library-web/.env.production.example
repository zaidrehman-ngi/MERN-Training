# Production value. Set it in the hosting dashboard before the build runs,
# Vite writes it into the bundle at build time.
VITE_API_URL=https://your-api-host/api/v1

# Login, refresh and logout go through this site (vercel.json forwards
# them to the API), so the refresh cookie belongs to this site and
# browsers that block cross-site cookies still keep it.
VITE_AUTH_URL=/api/v1
