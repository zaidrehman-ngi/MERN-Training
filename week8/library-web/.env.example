# Copy this file to .env and set the values for your machine.

# Base URL of library-api. It ends up in the browser bundle, so never put secrets here.
VITE_API_URL=http://localhost:3000/api/v1

# Optional. Base URL for login, refresh and logout. Leave it out locally
# and they use VITE_API_URL.
# VITE_AUTH_URL=
